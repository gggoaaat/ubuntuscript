// Simple Plymouth theme template

// Background color fallback (in case image fails)
Window.SetBackgroundTopColor (0.0, 0.0, 0.0);   
Window.SetBackgroundBottomColor (0.0, 0.0, 0.0);

// Rotate if your display is flipped
rotate_degrees = 0.0; // set to 180.0 if upside down
Window.SetRotation(rotate_degrees);

// Load assets
bg = Image("background.png");
logo = Image("logo.png");

// Get screen size
w = Window.GetWidth();
h = Window.GetHeight();

// Draw background (centered and scaled)
if (bg) {
    bgw = bg.GetWidth();
    bgh = bg.GetHeight();
    scale = max(w / bgw, h / bgh);
    sprite_bg = Sprite(bg);
    sprite_bg.SetScale(scale, scale);
    sprite_bg.SetX(w / 2 - (bgw * scale) / 2);
    sprite_bg.SetY(h / 2 - (bgh * scale) / 2);
}

// Draw logo (centered)
if (logo) {
    lw = logo.GetWidth();
    lh = logo.GetHeight();
    sprite_logo = Sprite(logo);
    sprite_logo.SetX(w / 2 - lw / 2);
    sprite_logo.SetY(h / 2 - lh / 2);
}

// Optional: spinner animation
angle = 0;
cx = w / 2;
cy = h / 2 + h * 0.15;
radius = h * 0.05;

fun draw_spinner() {
    for (i = 0; i < 12; i++) {
        a = (i * 30 + angle) * 3.14159 / 180.0;
        x = cx + radius * cos(a);
        y = cy + radius * sin(a);
        alpha = (i + 1) / 12.0;
        Plymouth.DrawCircle(x, y, h * 0.006, 1, 1, 1, alpha);
    }
}

fun Animate() {
    angle = (angle + 6) % 360;
    Plymouth.RestoreScreen();
    draw_spinner();
    Plymouth.QueueAnimation(Animate);
}

Plymouth.QueueAnimation(Animate);
